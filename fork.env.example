# ─────────────────────────────────────────────────────────────────────────
# FORK — one input file per brand. Copy to `fork.env`, fill in, then run:
#
#     npm run fork:env
#
# It writes .env (frontend), API/Mainapi/.env and API/proxiesembed/.env from
# their .env.example templates. Existing files are backed up first and their
# secrets are kept. See FORK-README §11.
# ─────────────────────────────────────────────────────────────────────────

# ── Brand ────────────────────────────────────────────────────────────────
SITE_DOMAIN=papadustream-v2.org          # bare hostname, no https://
SITE_NAME=PapaduStream

# Layout. Default = one domain, routed by path (/api, /anime/search, /proxy…).
# For subdomains instead, set e.g. https://api.example.org / https://proxy.example.org
API_URL=
PROXY_URL=

# Extra domains allowed by the API (mirrors), comma-separated. SITE_DOMAIN is always included.
EXTRA_DOMAINS=

# Service worker mirrors: hostnames used when the site is blocked.
# MIRRORS_CONFIG_URL = your own list (rentry page or JSON {"mirrors":[...]}); empty = DEFAULT_MIRRORS only.
DEFAULT_MIRRORS=
MIRRORS_CONFIG_URL=

# ── Required ─────────────────────────────────────────────────────────────
TMDB_API_KEY=
DB_USER=
DB_PASSWORD=

# ── Defaults are usually fine ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=movix
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
NUM_WORKERS=4
MAINAPI_PORT=25565
PROXIESEMBED_PORT=25569

# ── Optional ─────────────────────────────────────────────────────────────
# Cloudflare Turnstile widgets created for SITE_DOMAIN (visible + invisible).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_INVISIBLE_SITE_KEY=
TURNSTILE_INVISIBLE_SECRET_KEY=

# Secrets: leave empty — generated once, then kept from the existing .env.
# Set them only to copy secrets from another server.
JWT_SECRET=
MEDIA_SIGNING_SECRET=
INTERNAL_API_KEY=
TURNSTILE_IP_SALT=

# Any other variable: prefix it with the target file.
#   FE_<NAME>     -> .env                     e.g. FE_VITE_ANALYTICS_PROVIDER=plausible
#   API_<NAME>    -> API/Mainapi/.env         e.g. API_SWIFTFLOW_API_KEY=xxxx
#   PROXY_<NAME>  -> API/proxiesembed/.env    e.g. PROXY_DEBRID_ENABLED_PROVIDERS=
